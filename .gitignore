.venv/
.conda-lblrtm/
.uv-cache/
.pytest_cache/
__pycache__/
*.py[cod]
.jax_cache/
data/databases/
data/lblrtm/
data/corrections/
# Generated by scripts/generate_payne_zero_arcturus.py, which needs Payne
# Zero's 7 GB runtime tree. The .json provenance sidecars stay in git.
data/stellar/*.npz
# Corrected spectra and review panels, regenerated by
# scripts/export_corrected_spectrum.py and scripts/build_arcturus_review.py.
# The .json summaries beside them stay in git.
data/corrected/**/*.npz
# Self-contained spectra files from scripts/export_spectra_hdf5.py. Produced on
# demand for distribution; the run records beside them are the archival product
# and stay in git.
data/corrected/*spectra*.h5
data/corrected/*transmission*.h5
# Built from the file-5 fit by scripts/export_photatl_from_ftsspec.py.
data/corrected/photatl_corrected.h5
data/corrected/review/panels/
# The batch driver's own summary; scripts/trim_atlas_summary.py writes the
# committed record to docs/arcturus_atlas_summary.json.
data/corrected/atlas*/*.json
data/corrected/atlas*/record_shard*.h5
data/corrected/igrins/**/*.json
# RRISA reduced products and their catalog, fetched by
# scripts/download_rrisa_standard.py. The two-order fixture under tests/data
# is what stays in git.
data/igrins/
build/
dist/
benchmarks/results/*.json
benchmarks/results/*.npz
.jax-cache/
.jax_cache/
xla_gpu_per_fusion_autotune_cache_dir/

# Quarto renders of the notebooks. The executed .ipynb is committed and is the
# source of truth; the HTML is a build product and is 4 MB of embedded figures.
docs/*.html
docs/*_files/
.quarto/

# The review bundle: 31 MB of per-window arrays, rebuilt by
# scripts/export_solar_review.py + scripts/merge_review_bundle.py.
# The page itself is docs/review_page/index.html and is committed.
data/review/
data/review_[0-9]/

# Claude Code worktrees and session state.
.claude/
